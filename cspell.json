{
  "version": "0.2",
  "comment": "The spellcheck workflow scans every .md/.ts/.tsx/.js/.jsx in the repo; the vocabulary below covers the Ice identifiers and terms the docs use.",
  "ignorePaths": ["node_modules/**"],
  "patterns": [
    {
      "name": "heading-anchor",
      "pattern": "/\\{%\\s*id=\"[^\"]*\"\\s*%\\}/g",
      "description": "A heading's own anchor, such as {% id=\"ice.default.host-synopsis\" %}: lowercased names the heading text already spells"
    },
    {
      "name": "slot-name",
      "pattern": "/\\{%\\s*language-section name=\"[^\"]*\"[^%]*%\\}/g",
      "description": "A language slot's name, such as {% language-section name=\"ice.default.encodingversion\" /%}: lowercased names the heading it sits under already spells"
    }
  ],
  "ignoreRegExpList": ["heading-anchor", "slot-name"],
  "words": [
