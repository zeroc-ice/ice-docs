{
  "name": "ice-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23 || >=23.6",
    "npm": ">=11.16"
  },
  "scripts": {
    "predev": "npm run build:search",
    "dev": "next dev",
    "prebuild": "npm run check:markdoc && npm run build:search",
    "build": "next build",
    "build:search": "node scripts/build-search-index.js",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"lib/**/*.test.ts\" \"utils/**/*.test.ts\" \"scripts/**/*.test.js\"",
    "check:content": "node scripts/check-content.js",
    "check:markdoc": "node --import ./scripts/markdoc-esm-hooks.js scripts/check-markdoc.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@heroicons/react": "^2.2.0",
    "@markdoc/markdoc": "^0.5.10",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "js-yaml": "^5.4.2",
    "lucide-react": "^1.47.0",
    "mermaid": "^12.0.0",
    "next": "16.3.5",
    "next-sitemap": "^4.2.3",
    "next-themes": "^1.0.0-beta.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reading-time": "^1.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
