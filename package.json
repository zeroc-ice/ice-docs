{
  "name": "ice-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.16"
  },
  "scripts": {
    "predev": "npm run build:search",
    "dev": "next dev",
    "prebuild": "npm run check:markdoc && npm run build:search",
    "build": "next build",
    "build:search": "node scripts/build-search-index.ts",
    "start": "next start",
    "lint": "npm run lint:eslint && npm run lint:markdown",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:markdown": "markdownlint \"content/**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/markdoc-esm-hooks.ts --test \"lib/**/*.test.ts\" \"utils/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check:content": "node scripts/check-content.ts",
    "check:markdoc": "node --import ./scripts/markdoc-esm-hooks.ts scripts/check-markdoc.ts",
    "check:diagrams": "node scripts/check-diagrams.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@heroicons/react": "^2.2.0",
    "@markdoc/markdoc": "^0.5.10",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "js-yaml": "^5.5.0",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "next-themes": "^1.0.0-beta.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli": "^0.50.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "markdownlint-cli": {
      "js-yaml": "^5.4.1"
    }
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
