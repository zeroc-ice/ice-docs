{
  "private": true,
  "engines": {
    "node": ">=22.18 <23 || >=23.6",
    "npm": ">=11.16"
  },
  "scripts": {
    "predev": "npm run build:search",
    "dev": "next dev",
    "prebuild": "npm run check:markdoc && npm run build:search",
    "build": "next build",
    "build:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-search-index.mjs",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"lib/**/*.test.ts\" \"utils/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "check:markdoc": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/markdoc-esm-hooks.mjs scripts/check-markdoc.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@heroicons/react": "^2.2.0",
    "@markdoc/markdoc": "^0.5.7",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "js-yaml": "^5.2.1",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.15.0",
    "next": "16.3.4",
    "next-sitemap": "^4.2.3",
    "next-themes": "^1.0.0-beta.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reading-time": "^1.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
