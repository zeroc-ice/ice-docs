{
  "name": "ice-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15 <25 || >=26",
    "npm": ">=11.16"
  },
  "scripts": {
    "predev": "npm run build:search",
    "dev": "next dev",
    "prebuild": "npm run check:markdoc && npm run build:search",
    "build": "next build",
    "build:search": "node scripts/build-search-index.js",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "npm run lint:eslint && npm run lint:markdown",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:markdown": "markdownlint \"content/**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"lib/**/*.test.ts\" \"utils/**/*.test.ts\" \"scripts/**/*.test.js\"",
    "check:content": "node scripts/check-content.js",
    "check:markdoc": "node --import ./scripts/markdoc-esm-hooks.js scripts/check-markdoc.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@heroicons/react": "^2.2.0",
    "@markdoc/markdoc": "^0.5.7",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "js-yaml": "^5.2.1",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.15.0",
    "next": "16.3.4",
    "next-sitemap": "^4.2.3",
    "next-themes": "^1.0.0-beta.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
